# ==========================================================
# 运营智脑 环境变量模板
# 使用方式：Copy-Item .env.example .env  然后按需修改
# 注意：.env 含敏感信息，禁止提交到版本库
# ==========================================================

# ---------- 项目 ----------
PROJECT_NAME=运营智脑
PROJECT_SLOGAN=让数据自动做出最优决策
ENV=development
DEBUG=true
TIMEZONE=Asia/Shanghai

# ---------- 后端 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000
SECRET_KEY=change-me-to-a-random-32-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opscompass
POSTGRES_PASSWORD=opscompass_dev_pwd
POSTGRES_DB=opscompass
DATABASE_URL=postgresql+psycopg://opscompass:opscompass_dev_pwd@localhost:5432/opscompass

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 前端 ----------
FRONTEND_PORT=80
VITE_APP_TITLE=运营智脑
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- 安全日志分级 ----------
# 独立文件通道（默认 logs/security.log），按级别过滤并支持高危事件告警镜像
SECURITY_LOG_ENABLED=true
# 低于该级别不落文件：INFO / WARNING / CRITICAL
SECURITY_LOG_MIN_LEVEL=INFO
SECURITY_LOG_FILE=security.log
SECURITY_LOG_MAX_BYTES=5242880
SECURITY_LOG_BACKUP_COUNT=5
# 达到该级别镜像到主日志（app.log / 控制台），供外部告警抓取
SECURITY_LOG_ALERT_LEVEL=CRITICAL
SECURITY_LOG_MIRROR_TO_MAIN=true

# ---------- 数据目录 ----------
DATA_DIR=./data
EXPORT_DIR=./data/exports
LOG_DIR=./logs
